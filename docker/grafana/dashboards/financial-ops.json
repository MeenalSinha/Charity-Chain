    {
      "title": "Donation Capture Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(charitychain_donations_captured_total[5m])) by (currency)",
          "legendFormat": "{{currency}} Captures/sec"
        }
      ]
    },
    {
      "title": "Total Captured Volume (USD Minor Units)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(charitychain_donations_captured_minor_units_total{currency=\"USD\"})",
          "legendFormat": "USD Cents"
        }
      ]
    },
    {
      "title": "Refund Volume & Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(charitychain_refunds_processed_total[10m])) by (currency)",
          "legendFormat": "{{currency}} Refunds/sec"
        }
      ]
    },
    {
      "title": "Donations vs Refunds Ratio",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(charitychain_refunds_processed_total) / clamp_min(sum(charitychain_donations_captured_total), 1)",
          "legendFormat": "Refund Ratio"
        }
      ]
    }
