# ============================================================
# CharityChain — .env.staging.example
# Staging Environment Configuration Template
# Phase 14: Sandbox PayPal, real infrastructure wiring
# ============================================================

ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=charity_user
POSTGRES_PASSWORD=staging_password_change_me
POSTGRES_DB=charitychain_staging
DATABASE_URL=postgresql+asyncpg://charity_user:staging_password_change_me@localhost:5432/charitychain_staging

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
RATE_LIMIT_REDIS_REQUIRED=false

# --- Security Keys ---
SECRET_KEY=staging-secret-key-at-least-64-hex-chars-change-before-use-00000000
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
JWT_SECRET_KEY=staging-jwt-key-at-least-64-hex-chars-change-before-use-000000000
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- PayPal (Sandbox) ---
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=REPLACE_WITH_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_SANDBOX_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=REPLACE_WITH_SANDBOX_WEBHOOK_ID

# --- Email ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@staging.charitychain.dev
EMAIL_FROM_NAME=CharityChain Staging

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- Storage ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/evidence
BACKUP_BUCKET_NAME=charitychain-backups-staging

# --- Rate Limiting ---
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=30
RATE_LIMIT_FINANCIAL_REQUESTS_PER_MINUTE=60
RATE_LIMIT_EVIDENCE_REQUESTS_PER_MINUTE=90
RATE_LIMIT_GLOBAL_REQUESTS_PER_MINUTE=300

# --- Observability ---
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=staging_grafana_password

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=

