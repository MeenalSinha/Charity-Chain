# ============================================================================
# CharityChain Environment Configuration Template
# ============================================================================
# Copy this file to .env and provide your deployment-specific credentials.
# NEVER commit .env to version control.

# Application Environment (development, testing, staging, production)
ENVIRONMENT=development
DEBUG=true

# API & Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501

# Database Configuration (Phase 1+ PostgreSQL; Phase 0 TinyDB fallback)
# For local PostgreSQL: postgresql+asyncpg://charity:charity_password@localhost:5432/charitychain
DATABASE_URL=sqlite+aiosqlite:///./data/charity_app.db
TINYDB_PATH=data/charity.db

# Storage Providers (local, s3, minio, pinata)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=data/evidence
STORAGE_DOCUMENTS_DIR=data/documents
MAX_UPLOAD_SIZE_MB=10.0
MAX_UPLOAD_BATCH_SIZE=10
PRESIGNED_URL_EXPIRATION_SECONDS=3600
# S3 / MinIO Settings (e.g. S3_ENDPOINT_URL=http://localhost:9000 for MinIO)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=charitychain-evidence
S3_REGION=us-east-1

# IPFS Pinning (Optional legacy fallback)
WEB3_STORAGE_TOKEN=
PINATA_API_KEY=
PINATA_SECRET=

# AI / Computer Vision Configuration (Phase 6)
YOLO_MODEL_PATH=yolov8n.pt
YOLO_EXPECTED_HASH=f59b3d833e2ff32e194b5bb8e08d211dc7c5bdf144b90d2c8412c47ccfc83b36
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_DEVICE=cpu
VERIFICATION_CONFIDENCE_THRESHOLD=0.65
TAMPER_ELA_THRESHOLD=12.0
PHASH_DISTANCE_THRESHOLD=10
SSIM_SIMILARITY_THRESHOLD=0.60
GPS_RADIUS_METERS=1000
MIN_DETECTIONS=1
VERIFICATION_PIPELINE_VERSION=v6.0.0
AI_PROVIDER=yolo_forensics
CALIBRATION_VERSION=heuristic_v1_unvalidated
CALIBRATION_STATUS=UNVALIDATED
MAX_IMAGE_PIXELS=25000000
MAX_PDF_PAGES=10
DIAGNOSTIC_ARTIFACTS_DIR=storage/artifacts

# LLM Explainability Settings (Optional)
LLM_PROVIDER=none
LLM_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20.0
OPENAI_API_KEY=
GEMINI_API_KEY=

# Background Job Queue
VERIFICATION_JOB_MAX_ATTEMPTS=3
VERIFICATION_JOB_TIMEOUT_SECONDS=120

# Payment Provider Configuration (Phase 4 PayPal REST API)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Security & Secrets (Generate strong random secrets for production)
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Human Review & Decision Workflows (Phase 7)
REVIEW_REQUIRED_APPROVALS=2
REVIEW_ASSIGNMENT_POLICY=DUAL_INDEPENDENT
REVIEW_MAX_OPEN_TASKS_PER_REVIEWER=5
REVIEW_TASK_DUE_HOURS=72
REVIEW_SECOND_REVIEW_REQUIRED=true
REVIEW_APPEAL_WINDOW_HOURS=168
REVIEW_MAX_APPEALS_PER_CASE=1
REVIEW_REVISION_DUE_HOURS=336
REVIEW_MAX_REASSIGNMENTS=3
REVIEW_REQUIRE_COMPLETED_AI_REPORT=true
REVIEW_REQUIRE_EVIDENCE_INTEGRITY=true
REVIEW_POLICY_VERSION=v7.0.0

