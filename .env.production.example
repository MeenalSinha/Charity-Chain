# ============================================================
# CharityChain — .env.production.example
# Production Environment Configuration Template
# Phase 14: Copy to .env, fill ALL values, never commit .env
# ============================================================

# --- Application ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
# Use a managed Cloud SQL / RDS instance in production
POSTGRES_HOST=your-cloud-sql-host
POSTGRES_PORT=5432
POSTGRES_USER=charity_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_32_CHARS_MIN
POSTGRES_DB=charitychain
DATABASE_URL=postgresql+asyncpg://charity_user:REPLACE@your-cloud-sql-host:5432/charitychain

# --- Redis (Rate Limiting, Outbox) ---
# Use Memorystore / ElastiCache in production
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@your-redis-host:6379/0
REDIS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_32_CHARS_MIN
RATE_LIMIT_REDIS_REQUIRED=true

# --- Security Keys (NEVER expose or commit) ---
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_128_HEX_CHARS

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_BASE64_KEY

# Generate: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_128_HEX_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- PayPal (LIVE — requires explicit authorization to enable) ---
# CAUTION: Set PAYPAL_ENVIRONMENT=live only after full testing and authorization
PAYPAL_ENVIRONMENT=live
PAYPAL_CLIENT_ID=REPLACE_WITH_LIVE_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_LIVE_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=REPLACE_WITH_LIVE_WEBHOOK_ID

# --- Email (SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=apikey
SMTP_PASSWORD=REPLACE_WITH_SENDGRID_API_KEY
EMAIL_FROM_ADDRESS=noreply@your-domain.com
EMAIL_FROM_NAME=CharityChain

# --- Sentry (Error Monitoring) ---
# REQUIRED in production — prevents starting without it
SENTRY_DSN=https://REPLACE@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Storage ---
# For production: use GCS or S3
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=charitychain-evidence-prod
S3_REGION=us-central1
S3_ENDPOINT_URL=https://storage.googleapis.com
S3_ACCESS_KEY_ID=REPLACE_WITH_SERVICE_ACCOUNT_HMAC_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SERVICE_ACCOUNT_HMAC_SECRET

# Separate bucket for backups
BACKUP_BUCKET_NAME=charitychain-backups-prod

# --- Rate Limiting Tiers ---
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
RATE_LIMIT_FINANCIAL_REQUESTS_PER_MINUTE=20
RATE_LIMIT_EVIDENCE_REQUESTS_PER_MINUTE=30
RATE_LIMIT_GLOBAL_REQUESTS_PER_MINUTE=100

# --- Observability ---
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
GRAFANA_DOMAIN=grafana.your-domain.com

# --- Signing Keys (Ed25519 — Impact Certificates) ---
# Generated via: python -m backend.app.cli generate-issuer-key
SIGNING_KEY_PATH=/run/secrets/charitychain_signing_key
SIGNING_KEY_ID=production-key-001

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api/v1
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE@o0.ingest.sentry.io/0

# --- Feature Flags ---
FEATURE_PAYPAL_LIVE_ENABLED=false   # Set to true only after explicit authorization
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_WEBHOOK_DELIVERIES=true

